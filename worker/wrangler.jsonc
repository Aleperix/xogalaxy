{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "XOGALAXY_KV",
      "id": "fec71c8f31c7405a9cf6e36715026c2c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xogalaxy",
      "database_id": "REPLACE_ME_RUN_wrangler_d1_create"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STATS",
        "class_name": "Stats"
      },
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Stats"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://xogalax.blogspot.com,https://xogalaxy.pages.dev",
    "GOOGLE_CLIENT_ID": "REPLACE_ME_CREATE_EN_GOOGLE_CLOUD_CONSOLE.apps.googleusercontent.com",
    "OWNER_SUBS": "REPLACE_ME_GOOGLE_SUB_DEL_OWNER",
    "XOGALAXY_GH_REPO": "aleperix/xogalaxy-backup"
  },
  "triggers": {
    "crons": ["17 4 * * *"]
  }
}
