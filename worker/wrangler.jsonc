{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "XOGALAXY_KV",
      "id": "fec71c8f31c7405a9cf6e36715026c2c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xogalaxy",
      "database_id": "eb3ca824-1e7b-4acc-9144-a24fee35d2d8"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STATS",
        "class_name": "Stats"
      },
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Stats"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://xogalax.blogspot.com,https://xogalaxy.pages.dev",
    "GOOGLE_CLIENT_ID": "876770060285-9t4e4oehkbpkvaqrfpt6fr1a2cdl8649.apps.googleusercontent.com",
    "OWNER_SUBS": "107284810985445490995",
    "XOGALAXY_GH_REPO": "aleperix/xogalaxy-backup",
    "EMAIL_PROVIDER": "gmail",
    "EMAIL_FROM_DOMAIN": "xogalaxy.com"
  },
  "triggers": {
    "crons": ["17 4 * * *", "45 4 * * 1"]
  }
}
