{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "media",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "xogalaxy-images"
    }
  ]
}